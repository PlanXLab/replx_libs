"""
XNode Onboard Environmental Sensors Submodule (BH1750 & BME680)

Separated from the core xnode/__init__.py to prevent loading heavy floating-point
calibration and IAQ algorithms when only basic GPIO/I2C is needed.

Author: PlanXLab Development Team
"""

from typing import Iterator

class Illuminance:
    """Illuminance sensor interface for BH1750 ambient light sensor."""
    BH1750_ADDR: int
    POWER_OFF: int
    POWER_ON: int
    POWER_RESET: int
    CONT_HIGH_RES: int
    CONT_HIGH_RES_2: int
    CONT_LOW_RES: int
    ONE_TIME_HIGH_RES: int
    ONE_TIME_HIGH_RES_2: int
    ONE_TIME_LOW_RES: int

    def __init__(self, *, mode: int = 0x10) -> None: ...
    def init(self, mode: int = 0x10) -> None: ...
    def deinit(self) -> None: ...
    def read_raw(self) -> int: ...
    def read_lux(self, continuous: bool = True) -> float: ...
    def read(self, continuous: bool = True) -> int: ...

class Tphg:
    """Environmental sensor interface for BME680 (Temperature, Pressure, Humidity, Gas & IAQ)."""
    BME680_ADDR: int
    FORCED_MODE: int
    SLEEP_MODE: int

    def __init__(self, temp_weighting: float = 0.10, pressure_weighting: float = 0.05,
                 humi_weighting: float = 0.20, gas_weighting: float = 0.65,
                 gas_ema_alpha: float = 0.1, temp_baseline: float = 23.0,
                 pressure_baseline: float = 1013.25, humi_baseline: float = 45.0,
                 gas_baseline: int = 450000) -> None: ...
    @property
    def temperature_offset(self) -> float: ...
    @temperature_offset.setter
    def temperature_offset(self, value: float) -> None: ...
    @property
    def temperature(self) -> float: ...
    @property
    def pressure(self) -> float: ...
    @property
    def humidity(self) -> float: ...
    @property
    def gas(self) -> float: ...
    def set_temperature_correction(self, value: float, relative: bool = True) -> None: ...
    def read(self, gas: bool = False) -> tuple[float, float, float, float | None]: ...
    def sealevel(self, altitude: float) -> tuple[float, float]: ...
    def altitude(self, sealevel: float = 1013.25) -> tuple[float, float]: ...
    def iaq(self) -> tuple[int, float, float, float, float]: ...
    def burn_in(self, threshold: float = 0.01, count: int = 10,
                timeout_sec: int = 180) -> Iterator[tuple[bool, float, float]]: ...
    def burnIn(self, threshold: float = 0.01, count: int = 10,
               timeout_sec: int = 180) -> Iterator[tuple[bool, float, float]]: ...
